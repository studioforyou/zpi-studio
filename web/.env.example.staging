# Template for the staging environment (backend in the cloud): copy to .env.staging.local and adjust.

# Base URL of the backend API. Empty means same origin (the Vite proxy forwards /api and /actuator);
# set it for a staging build served from a different address than the backend.
VITE_API_BASE_URL=
# Where the Vite dev server forwards /api and /actuator.
DEV_API_PROXY_TARGET=https://staging.example.com
