# Należy skopiować ten plik do .env i uzupełnić wartości przed uruchomieniem docker-compose.
LOCAL_DB_USER=zpi_user
LOCAL_DB_PASSWORD=zpi_password
# Firebase project whose ID tokens the backend accepts (local development uses the dev project)
FIREBASE_PROJECT_ID=studioforyou-dev
# E-mail: LOG only writes e-mails to the backend log; BREVO sends them (MAIL_FROM must be a verified Brevo sender)
MAIL_PROVIDER=LOG
MAIL_FROM=no-reply@studioforyou.local
BREVO_API_KEY=
